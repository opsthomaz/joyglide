# Build output
build
dist
*.icns
*.iconset
*.ico

# Python venvs (both macOS and Windows variants)
.venv
.venv-win
venv

# Python cache
__pycache__
*.pyc
*.pyo

# Coverage artifacts (generated by pytest-cov in CI lint workflow)
.coverage
coverage.xml

# Mutation testing scratch dir (mutmut copies modules here; recreated each run)
mutants/
.mutmut-cache
# cosmic-ray session DB — regenerated by run_cosmic_ray.sh on every run
cosmic-ray-session.sqlite
session.sqlite

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Claude Code per-user state. The .claude/agents/ dir IS committed
# (project-level subagent definitions), but settings.local.json holds
# the user's individual tool-permission grants and shouldn't ship.
.claude/settings.local.json

# Reference research clones — kept locally for offline reference but
# bulky (~76MB) and redundant with the URL citations in ARCHITECTURE.md /
# RESEARCH.md / WINDOWS.md.
research/

# PyInstaller spec output is fine to commit; build dir already covered above.
*.manifest

# Transfer artifacts (zip used to move files between machines)
Archive.zip
*.tar.gz
